# Copia de referencia. `qt up` crea platform/.env (ignorado por git) a partir de
# este archivo y genera las contraseñas que falten. No pongas secretos aquí.

# Organización de GitHub (respeta MAYÚSCULAS/minúsculas: Vault valida los
# claims OIDC con comparación exacta). Las imágenes quedan en ghcr.io/quantumtechpe/...
GITHUB_OWNER=QuantumTechPE
# Cuenta donde está instalada la GitHub App (normalmente igual a GITHUB_OWNER)
GITHUB_APP_LOGIN=QuantumTechPE
# App ID (numérico) de la GitHub App de plataforma (no es secreto)
GOVERNANCE_APP_ID=

# Aprobaciones de admins requeridas para mergear a master. GitHub no deja que el
# autor apruebe su propio PR: hace falta otro admin. Se aplica con github-bootstrap.sh.
ADMIN_APPROVALS_REQUIRED=1

# Repos de plataforma
INFRA_REPO=qt-infra
GITOPS_REPO=qt-gitops

# IP o DNS de ESTA máquina en la red de los servidores: los clústeres k3s se
# conectan a Vault por aquí (va en el certificado TLS). Varias, separadas por coma.
PLATFORM_HOST=192.168.1.50

# Dominio del Ingress por ambiente (opcional). Por defecto: ingress_domain del
# inventario o <IP del primer control-plane>.nip.io
INGRESS_DOMAIN_DEV=
INGRESS_DOMAIN_QA=
INGRESS_DOMAIN_PROD=
# Puerto HTTP del Ingress (vacío = 80). `qt k8s-local` usa 8081/8082/8083 y
# completa estos valores por ti.
INGRESS_PORT_DEV=
INGRESS_PORT_QA=
INGRESS_PORT_PROD=

# Runners self-hosted efímeros en paralelo
RUNNER_REPLICAS=2

# Audiencia (aud) del token OIDC de GitHub que Vault acepta
VAULT_AUDIENCE=qt-vault

# Se autogenera en el primer `qt up`
SONAR_DB_PASSWORD=
