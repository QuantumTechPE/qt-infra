# Generado por qt-infra (k8s/provisioning). No editar a mano.
token: "{{ k3s_token }}"
write-kubeconfig-mode: "0600"
secrets-encryption: true
tls-san:
  - "{{ ansible_host }}"
  - "{{ k3s_api_endpoint }}"
{% for san in k3s_tls_san_extra %}
  - "{{ san }}"
{% endfor %}
node-label:
  - "qt.platform/environment={{ cluster_env }}"
# Reserva para el sistema operativo y k3s (group_vars/all.yml o el inventario)
kubelet-arg:
  - "system-reserved={{ k3s_system_reserved }}"
  - "kube-reserved={{ k3s_kube_reserved }}"
  - "eviction-hard={{ k3s_eviction_hard }}"
{% if groups['k3s_server'] | length > 1 %}
{% if inventory_hostname == groups['k3s_server'][0] %}
# Primer control-plane: inicializa etcd embebido (HA)
cluster-init: true
{% else %}
server: "https://{{ k3s_api_endpoint }}:6443"
{% endif %}
{% endif %}
